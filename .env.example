# Copy this file to .env and fill in real values

# MongoDB connection string. If unset/unreachable, the app falls back to an
# in-memory store so you can still demo auth + WebSocket locally.
MONGO_URI=mongodb+srv://somu:Somu8499@cluster0.61aqpsp.mongodb.net/citsx
MONGO_DB_NAME=citsx

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated origins allowed to talk to the API
CORS_ORIGINS=http://localhost:5173

# Comm radius for nearby-vehicle filtering, meters
COMM_RADIUS_METERS=500
